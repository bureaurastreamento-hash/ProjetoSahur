{
  "name": "ProjetoSahur",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      },
      "Assets": {
        "$path": "src/assets",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client",
          "$ignoreUnknownInstances": true
        },
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true,
      "StarterCharacterScripts": {
        "$path": "src/character",
        "$ignoreUnknownInstances": true
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "Sahur": {
        "$path": "src/workspace",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerStorage": {
      "Maps": {
        "$path": "src/maps",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },
    "$ignoreUnknownInstances": true,
    "StarterGui": {
      "$path": "src/ui",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ShowDevelopmentGui": false
      }
    }
  }
}
