            "Color": [
              0.2,
              0.6,
              0.9
            ]
          }
        }
      }
    },
    "ServerStorage": {
      "Maps": {
        "$path": "src/maps",
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },
    "$ignoreUnknownInstances": true
  }
}
